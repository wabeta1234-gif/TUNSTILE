{
  "version": 2,
  "buildCommand": "npm install",
  "installCommand": "npm install",
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "THREAD": "2",
    "HEADLESS": "true",
    "BROWSER_TYPE": "chromium"
  },
  "functions": {
    "src/index.js": {
      "memory": 3008,
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "src/index.js"
    }
  ]
}